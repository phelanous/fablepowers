#!/usr/bin/env bash
# Per-plan workspace + review package for fablepowers reviews.
#
# Usage:
#   review-package --init PLAN_FILE
#       Create <toplevel>/.fablepowers/<plan-basename>/ (and
#       <toplevel>/.fablepowers/.gitignore containing '*' if absent);
#       print the workspace path.
#   review-package PLAN_FILE BASE_BRANCH [HEAD]
#       As --init, then write <workspace>/review-<mb7>..<head7>.diff with the
#       commit list, --stat and -U10 diff of MB..HEAD, where
#       MB = git merge-base BASE_BRANCH HEAD. Diffing from the merge-base (not
#       the bare base branch) keeps base-side changes made after the branch
#       point out of the package.
#
# <toplevel> is the top level of the worktree the command runs in, not of the
# plan file's location. Run it as `bash <dir>/review-package ...` so stripped
# exec bits do not matter.
#
# Exit codes: 2 bad arguments / unknown ref / missing plan / not in a git repo;
#             3 empty range or no common history between BASE_BRANCH and HEAD.
set -euo pipefail

usage() {
  echo "usage: review-package --init PLAN_FILE" >&2
  echo "       review-package PLAN_FILE BASE_BRANCH [HEAD]" >&2
  exit 2
}

# init_workspace PLAN_FILE — sets $workspace; creates it and the ignore file.
init_workspace() {
  local plan=$1 toplevel name
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "not in a git repository" >&2; exit 2; }
  name=$(basename "$plan")
  name=${name%.md}
  mkdir -p "$toplevel/.fablepowers/$name"
  # Only when absent: a repo may commit its own .fablepowers/.gitignore.
  [ -e "$toplevel/.fablepowers/.gitignore" ] \
    || printf '*\n' > "$toplevel/.fablepowers/.gitignore"
  workspace="$toplevel/.fablepowers/$name"
}

if [ $# -ge 1 ] && [ "$1" = "--init" ]; then
  [ $# -eq 2 ] || usage
  init_workspace "$2"
  echo "$workspace"
  exit 0
fi

[ $# -eq 2 ] || [ $# -eq 3 ] || usage
plan=$1
base=$2
head=${3:-HEAD}

init_workspace "$plan"

git rev-parse --verify --quiet "${base}^{commit}" >/dev/null \
  || { echo "unknown ref: $base" >&2; exit 2; }
git rev-parse --verify --quiet "${head}^{commit}" >/dev/null \
  || { echo "unknown ref: $head" >&2; exit 2; }

mb=$(git merge-base "$base" "$head") \
  || { echo "no common history between $base and $head" >&2; exit 3; }

commits=$(git rev-list --count "${mb}..${head}")
[ "$commits" -gt 0 ] || { echo "empty commit range: ${base}...${head}" >&2; exit 3; }

out="$workspace/review-$(git rev-parse --short=7 "$mb")..$(git rev-parse --short=7 "$head").diff"

{
  echo "# Review package: ${mb}..$(git rev-parse "$head") (base ${base}, head ${head})"
  echo
  echo "## Commits"
  git log --oneline "${mb}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${mb}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${mb}..${head}"
} > "$out"

echo "wrote ${out}: ${commits} commit(s)"
