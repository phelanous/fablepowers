#!/usr/bin/env bash
# Launcher for the fablepowers design-approval gate (hooks/approval_gate.py).
#
# hooks.json runs it the same way as session-start: an sh-builtin command picks
# a bash ($BASH, then /bin/bash, /usr/bin/bash, /usr/local/bin/bash,
# /opt/homebrew/bin/bash, then PATH) and execs this script. Bash builtins only
# until python is found, so an empty or broken PATH still works.
#
# Python: $FABLEPOWERS_PYTHON if set (a user override and the test seam; when
# set it is the only candidate), else python3 on PATH, then /usr/bin/python3,
# /usr/local/bin/python3, /opt/homebrew/bin/python3. A candidate must be
# Python 3.8+. The hook payload on stdin passes straight through to python.
#
# No usable python: the gate is disabled (every call allowed). Inside a git
# repo it warns, once per session, when the call is one where the gate would
# have acted: a PostToolUse Write creating a .md under docs/specs/ (a design
# would have become pending), an AskUserQuestion call (the approval answer),
# or a UserPromptExpansion of fablepowers:approve or fablepowers:withdraw. In
# a repo whose <toplevel>/.fablepowers/ exists it warns on any call. Other
# calls, and everything outside git, stay silent. The event is classified with
# bash pattern matches on the raw payload. Once per session means a marker
# file ${TMPDIR:-/tmp}/fablepowers-gate-warned-<uid>-<session_id>, created with
# noclobber; a payload with no session_id warns on every qualifying call.
# Always exits 0.

case "$0" in
    */*) SCRIPT_DIR="${0%/*}"; SCRIPT_DIR="${SCRIPT_DIR:-/}" ;;
    *) SCRIPT_DIR="." ;;
esac

usable() {
    [[ -n "$1" && -f "$1" && -x "$1" ]] \
        && "$1" -I -c 'import sys; sys.exit(sys.version_info < (3, 8))' </dev/null >/dev/null 2>&1
}

if [[ -n "${FABLEPOWERS_PYTHON:-}" ]]; then
    candidates=("$FABLEPOWERS_PYTHON")
else
    candidates=()
    p="$(command -v python3 2>/dev/null)" && candidates+=("$p")
    candidates+=(/usr/bin/python3 /usr/local/bin/python3 /opt/homebrew/bin/python3)
fi

for py in "${candidates[@]}"; do
    if usable "$py"; then
        exec "$py" -I "$SCRIPT_DIR/approval_gate.py"
    fi
done

# --- no usable python: warn and allow --------------------------------------------

warning='{"systemMessage":"fablepowers approval gate disabled: python3 not found"}'

payload=""
IFS= read -r -d '' payload || true

sid=""
cwd=""
re_sid='"session_id"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]+)"'
re_cwd='"cwd"[[:space:]]*:[[:space:]]*"([^"\\]+)"'
[[ "$payload" =~ $re_sid ]] && sid="${BASH_REMATCH[1]}"
[[ "$payload" =~ $re_cwd ]] && cwd="${BASH_REMATCH[1]}"

top=""
if [[ "$cwd" == /* ]]; then
    d="$cwd"
    while :; do
        if [[ -e "$d/.git" ]]; then top="$d"; break; fi
        [[ "$d" == "/" || -z "$d" ]] && break
        d="${d%/*}"; d="${d:-/}"
    done
fi

[[ -n "$top" ]] || exit 0

ws='[[:space:]]*'
gate_event=0
if [[ -d "$top/.fablepowers" ]]; then
    gate_event=1
elif [[ "$payload" =~ \"tool_name\"$ws:$ws\"AskUserQuestion\" ]]; then
    gate_event=1
elif [[ "$payload" =~ \"hook_event_name\"$ws:$ws\"UserPromptExpansion\" \
        && "$payload" =~ \"command_name\"$ws:$ws\"fablepowers:(approve|withdraw)\" ]]; then
    gate_event=1
elif [[ "$payload" =~ \"hook_event_name\"$ws:$ws\"PostToolUse\" \
        && "$payload" =~ \"tool_name\"$ws:$ws\"Write\" \
        && "$payload" =~ \"type\"$ws:$ws\"create\" \
        && "$payload" =~ \"file_path\"$ws:$ws\"([^\"]*)\" ]]; then
    case "${BASH_REMATCH[1]}" in
        */docs/specs/*.md|docs/specs/*.md) gate_event=1 ;;
    esac
fi
(( gate_event )) || exit 0

if [[ -n "$sid" ]]; then
    marker="${TMPDIR:-/tmp}"
    marker="${marker%/}/fablepowers-gate-warned-${UID:-0}-$sid"
    [[ -e "$marker" || -L "$marker" ]] && exit 0
    ( set -C; : > "$marker" ) 2>/dev/null || true
fi

printf '%s\n' "$warning"
exit 0
