#!/usr/bin/env bash
# SessionStart hook for the fablepowers plugin.
# Injects the workflow map so a session knows the entry point before it starts work.
#
# Uses bash builtins only (no dirname, awk, cat ...), so it works with an empty
# or broken PATH. hooks.json runs it as "${BASH:-bash}" <this file> under
# "shell": "bash", so bash itself is never looked up on PATH either.

set -euo pipefail

# Directory of this script, from $0 by parameter expansion. A $0 without a slash
# means the script was run from its own directory.
case "$0" in
    */*) SCRIPT_DIR="${0%/*}"; SCRIPT_DIR="${SCRIPT_DIR:-/}" ;;
    *) SCRIPT_DIR="." ;;
esac
SKILL_FILE="${SCRIPT_DIR}/../skills/workflow/SKILL.md"

# Strip a leading YAML frontmatter block (first line exactly "---" up to the next
# line exactly "---") so the session gets the map body, not the metadata. Only a
# block starting on line 1 counts; an unclosed block drops the whole file.
strip_frontmatter() {
    local s="$1" rest after
    if [[ "$s" != "---" && "$s" != "---"$'\n'* ]]; then
        printf '%s' "$s"
        return
    fi
    rest="${s#---}"
    rest="${rest#$'\n'}"
    # Bracket with newlines so the closing line is always "\n---\n"; the
    # shortest-prefix removal finds the first one.
    rest=$'\n'"${rest}"$'\n'
    if [[ "$rest" == *$'\n---\n'* ]]; then
        # The bracketing newline left at the end is dropped by the caller's
        # command substitution, as awk's trailing newline was in 0.2.x.
        after="${rest#*$'\n---\n'}"
        printf '%s' "$after"
    fi
}

if [[ -r "$SKILL_FILE" && -f "$SKILL_FILE" ]]; then
    workflow_content="$(strip_frontmatter "$(<"$SKILL_FILE")")"
else
    workflow_content="Error reading the fablepowers:workflow skill"
fi

# Escape a string for embedding in a JSON string literal. Each ${s//old/new}
# is a single C-level pass, so this stays fast on a whole SKILL.md.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

preamble="You have fablepowers. The workflow map below is \`fablepowers:workflow\`, your entry point for substantive dev work. Invoke the other skills through the Skill tool as \`fablepowers:<skill>\`; dispatch the implementer, strict-implementer and reviewer agents through the Agent tool with \`subagent_type: \"fablepowers:<agent>\"\`."

session_context="$(escape_for_json "${preamble}")\\n\\n$(escape_for_json "${workflow_content}")"

# printf rather than a heredoc: bash 5.3+ can hang on heredocs in hooks.
printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"

exit 0
