#!/usr/bin/env bash
# SessionStart hook for the fablepowers plugin.
# Injects the workflow map so a session knows the entry point before it starts work.
#
# Uses bash builtins only (no dirname, awk, cat ...), so it works with an empty
# or broken PATH. Claude Code runs the hooks.json command through /bin/sh -c
# (BASH=/bin/sh was observed on Linux even with "shell": "bash"). That command
# uses only sh builtins to pick a bash: $BASH if set, else the first executable
# of /bin/bash, /usr/bin/bash, /usr/local/bin/bash, /opt/homebrew/bin/bash.
# Only when none exists does it fall back to a PATH lookup of "bash".
# tests/hooks/test-session-start.sh runs it via /bin/sh -c and /bin/bash -c, and
# via a non-bash sh with BASH unset, each under a normal and an empty PATH.
#
# The same hook runs on Codex. The harness is detected from the SessionStart
# payload on stdin (see detect_harness). On Claude Code, and with empty stdin,
# the output is exactly 0.4.0's. On Codex the preamble names Codex, points to
# references/codex.md and carries the effective seat table: defaults overridden
# by the [codex] table of ${XDG_CONFIG_HOME:-$HOME/.config}/fablepowers/models.toml.
#
# OpenCode mode (argv flag --opencode, called by the OpenCode plugin): stdin is
# never read, and the output is one JSON object
#   {"context": "...", "seats": {"implementer": S, "strict_implementer": S,
#    "reviewer": S}, "warnings": ["...", ...]}
# where S is {"providerID":"...","id":"...","variant":"..."|null} for a seat
# pinned in the [opencode] table of models.toml, or null (session model).
#
# Pi mode (argv flag --pi, called by the Pi extension pi/fablepowers.ts): stdin
# is never read, and the output is one JSON object of the same shape
#   {"context": "...", "seats": {"implementer": S, "strict_implementer": S,
#    "reviewer": S}, "warnings": ["...", ...]}
# where S is {"provider":"...","id":"...","thinking":"<level>"|null} for a seat
# pinned in the [pi] table of models.toml, or null (session model and thinking).
# bash 3.2-compatible: no associative arrays, no ${x,,}, no mapfile.

set -euo pipefail

# Directory of this script, from $0 by parameter expansion. A $0 without a slash
# means the script was run from its own directory.
case "$0" in
    */*) SCRIPT_DIR="${0%/*}"; SCRIPT_DIR="${SCRIPT_DIR:-/}" ;;
    *) SCRIPT_DIR="." ;;
esac
SKILL_FILE="${SCRIPT_DIR}/../skills/workflow/SKILL.md"

# Strip a leading YAML frontmatter block (first line exactly "---" up to the next
# line exactly "---") so the session gets the map body, not the metadata. Only a
# block starting on line 1 counts; an unclosed block drops the whole file.
strip_frontmatter() {
    local s="$1" rest after
    if [[ "$s" != "---" && "$s" != "---"$'\n'* ]]; then
        printf '%s' "$s"
        return
    fi
    rest="${s#---}"
    rest="${rest#$'\n'}"
    # Bracket with newlines so the closing line is always "\n---\n"; the
    # shortest-prefix removal finds the first one.
    rest=$'\n'"${rest}"$'\n'
    if [[ "$rest" == *$'\n---\n'* ]]; then
        # The bracketing newline left at the end is dropped by the caller's
        # command substitution, as awk's trailing newline was in 0.2.x.
        after="${rest#*$'\n---\n'}"
        printf '%s' "$after"
    fi
}

if [[ -r "$SKILL_FILE" && -f "$SKILL_FILE" ]]; then
    workflow_content="$(strip_frontmatter "$(<"$SKILL_FILE")")"
else
    workflow_content="Error reading the fablepowers:workflow skill"
fi

# Escape a string for embedding in a JSON string literal. Each ${s//old/new}
# is a single C-level pass, so this stays fast on a whole SKILL.md.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# --- harness detection ---------------------------------------------------------

# The hook payload (JSON) arrives on stdin. One builtin read with a 1-second
# total timeout, so a stdin that never closes cannot block the session; skipped
# when stdin is a terminal. Empty or unreadable stdin leaves the payload empty.
# OpenCode and Pi modes are selected by their flag alone and never read stdin.
opencode_mode=0
pi_mode=0
if [[ "${1:-}" == --opencode ]]; then
    opencode_mode=1
elif [[ "${1:-}" == --pi ]]; then
    pi_mode=1
fi
payload=""
if [[ "$opencode_mode" -eq 0 && "$pi_mode" -eq 0 && ! -t 0 ]]; then
    IFS= read -r -t 1 -d '' payload 2>/dev/null || true
fi

# Codex iff, in order: the transcript_path basename is rollout-*.jsonl (Codex's
# session logs; Claude Code's are <uuid>.jsonl); else transcript_path lies under
# a .codex/sessions/ directory or $CODEX_HOME/sessions/; else PLUGIN_ROOT is set
# and equals CLAUDE_PLUGIN_ROOT (Codex sets both, Claude Code only
# CLAUDE_PLUGIN_ROOT). Otherwise Claude Code. The "model" and "permission_mode"
# keys are not used: Claude Code sends "model" on compact (captured live, Claude
# Code 2.1.299) and its shared hook-input builder carries permission_mode.
detect_harness() {
    local re_tp='"transcript_path"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
    local tp home
    harness="claude-code"
    if [[ "$payload" =~ $re_tp ]]; then
        tp="${BASH_REMATCH[1]}"
        tp="${tp//\\\//\/}"
        home="${CODEX_HOME:-}"
        home="${home%/}"
        if [[ "${tp##*/}" == rollout-*.jsonl ]]; then
            harness="codex"
        elif [[ "$tp" == */.codex/sessions/* ]]; then
            harness="codex"
        elif [[ -n "$home" && "$tp" == "$home"/sessions/* ]]; then
            harness="codex"
        fi
    fi
    if [[ "$harness" != codex && -n "${PLUGIN_ROOT:-}" && "${PLUGIN_ROOT}" == "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
        harness="codex"
    fi
}
if [[ "$opencode_mode" -eq 1 ]]; then
    harness="opencode"
elif [[ "$pi_mode" -eq 1 ]]; then
    harness="pi"
else
    detect_harness
fi

if [[ "$harness" == claude-code ]]; then
    preamble="You have fablepowers on Claude Code. The workflow map below is \`fablepowers:workflow\`, your entry point for substantive dev work. Invoke the other skills through the Skill tool as \`fablepowers:<skill>\`; dispatch the implementer, strict-implementer and reviewer seats through the Agent tool with \`subagent_type: \"fablepowers:<agent>\"\`, never the default general-purpose agent. Ask the user a structured question (the design approval) with AskUserQuestion; track tasks with TodoWrite. The rest of the mapping is in the workflow skill's \`references/claude-code.md\`."

    session_context="$(escape_for_json "${preamble}")\\n\\n$(escape_for_json "${workflow_content}")"

    # printf rather than a heredoc: bash 5.3+ can hang on heredocs in hooks.
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"

    exit 0
fi

# --- Codex, OpenCode and Pi: plugin root ----------------------------------------------------------

# Absolute plugin root from this script's directory (builtins only).
case "$SCRIPT_DIR" in
    /*) plugin_root="$SCRIPT_DIR" ;;
    *) plugin_root="${PWD:-.}/${SCRIPT_DIR}" ;;
esac
# normalize_path <absolute path>: drop empty and "." segments and resolve ".."
# lexically, so the root the context names is clean however the hook was invoked.
normalize_path() {
    local p="${1}/" out="" seg
    while [[ -n "$p" ]]; do
        seg="${p%%/*}"
        p="${p#*/}"
        case "$seg" in
            ''|.) ;;
            ..) out="${out%/*}" ;;
            *) out="${out}/${seg}" ;;
        esac
    done
    printf '%s' "${out:-/}"
}
plugin_root="$(normalize_path "${plugin_root}/..")"

# --- Codex, OpenCode and Pi: seat table from defaults + models.toml -----------

D_IMPL_MODEL="gpt-6.1-sol";    D_IMPL_EFFORT="high"
D_STRICT_MODEL="gpt-5.6-terra"; D_STRICT_EFFORT="medium"
D_REV_MODEL="gpt-6.1-sol";     D_REV_EFFORT="high"
implementer="$D_IMPL_MODEL";          implementer_effort="$D_IMPL_EFFORT"
strict_implementer="$D_STRICT_MODEL"; strict_implementer_effort="$D_STRICT_EFFORT"
reviewer="$D_REV_MODEL";              reviewer_effort="$D_REV_EFFORT"
# On OpenCode there are no defaults: an empty seat is unpinned (session model),
# and the effort keys are unused (a #variant on the model id covers them).
table="codex"
if [[ "$harness" == opencode ]]; then
    table="opencode"
    implementer=""; strict_implementer=""; reviewer=""
fi
# On Pi there are no defaults either: an empty seat is unpinned, an empty
# <seat>_thinking leaves Pi's default for the seat's model, and the effort keys
# are unused (<seat>_thinking replaces them).
implementer_thinking=""; strict_implementer_thinking=""; reviewer_thinking=""
if [[ "$harness" == pi ]]; then
    table="pi"
    implementer=""; strict_implementer=""; reviewer=""
fi

warn_count=0
warn_lines=""
warn_json=""
# Only the first 3 warnings reach the context; the rest are counted. warn_json
# holds the same lines as JSON string items, for OpenCode's "warnings" array.
warn() {
    warn_count=$((warn_count + 1))
    if [[ "$warn_count" -le 3 ]]; then
        warn_lines="${warn_lines}"$'\n'"- $1"
        warn_json="${warn_json},\"$(escape_for_json "$1")\""
    fi
}

# default_of <key>: that key's default value.
default_of() {
    case "$1" in
        implementer) printf '%s' "$D_IMPL_MODEL" ;;
        strict_implementer) printf '%s' "$D_STRICT_MODEL" ;;
        reviewer) printf '%s' "$D_REV_MODEL" ;;
        implementer_effort) printf '%s' "$D_IMPL_EFFORT" ;;
        strict_implementer_effort) printf '%s' "$D_STRICT_EFFORT" ;;
        reviewer_effort) printf '%s' "$D_REV_EFFORT" ;;
    esac
}

# set_key <key> <value>: key is one of the known names (checked by the caller).
set_key() {
    case "$1" in
        implementer_thinking) implementer_thinking="$2" ;;
        strict_implementer_thinking) strict_implementer_thinking="$2" ;;
        reviewer_thinking) reviewer_thinking="$2" ;;
        implementer) implementer="$2" ;;
        strict_implementer) strict_implementer="$2" ;;
        reviewer) reviewer="$2" ;;
        implementer_effort) implementer_effort="$2" ;;
        strict_implementer_effort) strict_implementer_effort="$2" ;;
        reviewer_effort) reviewer_effort="$2" ;;
    esac
}

# reject <line> <key> <why>: warn and put the key back to its default
# (on OpenCode and Pi: unpin the seat; on Pi a <seat>_thinking key goes back to
# Pi's default thinking).
reject() {
    local d
    if [[ "$table" == pi && "$2" == *_thinking ]]; then
        set_key "$2" ""
        warn "line $1: $2 $3; using Pi's default thinking."
        return 0
    fi
    if [[ "$table" == opencode || "$table" == pi ]]; then
        set_key "$2" ""
        warn "line $1: $2 $3; using the session model."
        return 0
    fi
    d="$(default_of "$2")"
    set_key "$2" "$d"
    warn "line $1: $2 $3; using the default $d."
}

# trim <string>: strip leading and trailing whitespace (spaces, tabs, ...).
trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# parse_models_toml <file>. Grammar: only the [$table] table is read ([codex] on
# Codex, [opencode] on OpenCode), other tables are ignored. Lines are key = "value"; full-line and trailing # comments
# (outside the quotes) are ignored; CRLF and a leading UTF-8 BOM are stripped.
# Keys: implementer, strict_implementer, reviewer (model ids, matching
# ^[A-Za-z0-9._:/-]{1,64}$) and <seat>_effort (low|medium|high|xhigh|max|ultra).
# Single-quoted or unquoted values, invalid values, unknown keys, malformed
# lines and an unreadable file each add a warning; a rejected key keeps its
# default. A duplicate key warns and the last occurrence wins. Warnings never
# quote file content beyond a validated key name.
# [opencode] differs only in its keys and values: implementer, strict_implementer
# and reviewer take provider/model with an optional #variant (charset
# [A-Za-z0-9._:/#-], at most 128 characters, non-empty provider, model path
# segments and variant, at most one #); a rejected seat is unpinned; a
# <seat>_effort key warns and is ignored.
# [pi] takes provider/model-id seats (charset [A-Za-z0-9._:@/-], at most 128
# characters, non-empty provider and path segments, no trailing :<thinking level>
# suffix) and <seat>_thinking (off|minimal|low|medium|high|xhigh|max); a rejected
# seat is unpinned, a rejected thinking key falls back to Pi's default, and a
# <seat>_effort key warns and is ignored. In [codex] and [opencode] the
# <seat>_thinking keys are unknown keys.
parse_models_toml() {
    local LC_ALL=C
    local file="$1" line n=0 in_codex=0 seen=" " hdr name key rest val after
    local re_key='^[A-Za-z0-9_-]+$' re_model='^[A-Za-z0-9._:/-]{1,64}$'
    local re_oc='^[A-Za-z0-9._:-]+/[A-Za-z0-9._:-]+(/[A-Za-z0-9._:-]+)*(#[A-Za-z0-9._:-]+)?$'
    local re_pi='^[A-Za-z0-9._:@-]+/[A-Za-z0-9._:@-]+(/[A-Za-z0-9._:@-]+)*$'
    local re_pi_suffix=':(off|minimal|low|medium|high|xhigh|max)$'
    [[ -e "$file" ]] || return 0
    if [[ ! -f "$file" || ! -r "$file" ]]; then
        if [[ "$table" == opencode || "$table" == pi ]]; then
            warn "models.toml is not a readable file; every seat runs on the session model."
        else
            warn "models.toml is not a readable file; using the defaults."
        fi
        return 0
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
        n=$((n + 1))
        if [[ "$n" -eq 1 ]]; then
            line="${line#$'\xef\xbb\xbf'}"
        fi
        # trim also strips a CRLF line's trailing \r ([:space:] includes it).
        line="$(trim "$line")"
        if [[ -z "$line" || "$line" == \#* ]]; then
            continue
        fi
        if [[ "$line" == \[* ]]; then
            hdr="$(trim "${line%%#*}")"
            in_codex=0
            if [[ "$hdr" == \[*\] ]]; then
                name="${hdr#\[}"
                name="$(trim "${name%\]}")"
                if [[ "$name" == "$table" ]]; then
                    in_codex=1
                fi
            else
                warn "line $n: malformed table header; ignored."
            fi
            continue
        fi
        if [[ "$in_codex" -ne 1 ]]; then
            continue
        fi
        if [[ "$line" != *=* ]]; then
            warn "line $n: not a key = \"value\" line; ignored."
            continue
        fi
        key="$(trim "${line%%=*}")"
        rest="$(trim "${line#*=}")"
        if [[ ! "$key" =~ $re_key ]]; then
            warn "line $n: malformed key; ignored."
            continue
        fi
        case "$key" in
            implementer|strict_implementer|reviewer|implementer_effort|strict_implementer_effort|reviewer_effort) ;;
            implementer_thinking|strict_implementer_thinking|reviewer_thinking)
                if [[ "$table" != pi ]]; then
                    warn "line $n: unknown key ${key:0:32}; ignored."
                    continue
                fi
                ;;
            *)
                warn "line $n: unknown key ${key:0:32}; ignored."
                continue
                ;;
        esac
        if [[ "$table" == opencode && "$key" == *_effort ]]; then
            warn "line $n: $key is not used on OpenCode (add a #variant to the model id); ignored."
            continue
        fi
        if [[ "$table" == pi && "$key" == *_effort ]]; then
            warn "line $n: $key is not used on Pi (use ${key%_effort}_thinking); ignored."
            continue
        fi
        if [[ "$seen" == *" $key "* ]]; then
            warn "line $n: duplicate key $key; the last one wins."
        fi
        seen="${seen}${key} "
        case "$rest" in
            \"*)
                val="${rest#\"}"
                if [[ "$val" != *\"* ]]; then
                    reject "$n" "$key" "has an unterminated string"
                    continue
                fi
                after="$(trim "${val#*\"}")"
                val="${val%%\"*}"
                if [[ -n "$after" && "$after" != \#* ]]; then
                    reject "$n" "$key" "has text after the value"
                    continue
                fi
                ;;
            \'*)
                reject "$n" "$key" "is single-quoted (use double quotes)"
                continue
                ;;
            *)
                reject "$n" "$key" "is not a double-quoted string"
                continue
                ;;
        esac
        case "$key" in
            *_effort)
                case "$val" in
                    low|medium|high|xhigh|max|ultra) set_key "$key" "$val" ;;
                    *) reject "$n" "$key" "is not low, medium, high, xhigh, max or ultra" ;;
                esac
                ;;
            *_thinking)
                case "$val" in
                    off|minimal|low|medium|high|xhigh|max) set_key "$key" "$val" ;;
                    *) reject "$n" "$key" "is not off, minimal, low, medium, high, xhigh or max" ;;
                esac
                ;;
            *)
                if [[ "$table" == opencode ]]; then
                    if [[ "${#val}" -le 128 && "$val" =~ $re_oc ]]; then
                        set_key "$key" "$val"
                    else
                        reject "$n" "$key" "is not a valid provider/model[#variant] id"
                    fi
                elif [[ "$table" == pi ]]; then
                    if [[ "$val" =~ $re_pi_suffix ]]; then
                        reject "$n" "$key" "ends in a :thinking suffix (use ${key}_thinking)"
                    elif [[ "${#val}" -le 128 && "$val" =~ $re_pi ]]; then
                        set_key "$key" "$val"
                    else
                        reject "$n" "$key" "is not a valid provider/model-id"
                    fi
                elif [[ "$val" =~ $re_model ]]; then
                    set_key "$key" "$val"
                else
                    reject "$n" "$key" "is not a valid model id"
                fi
                ;;
        esac
    done < "$file"
}

config_home="${XDG_CONFIG_HOME:-}"
if [[ -z "$config_home" && -n "${HOME:-}" ]]; then
    config_home="${HOME}/.config"
fi
models_file=""
if [[ -n "$config_home" ]]; then
    models_file="${config_home}/fablepowers/models.toml"
    parse_models_toml "$models_file"
fi

# Pi: a <seat>_thinking without a pinned model for that seat is ignored (the
# seat inherits the session's model and thinking).
if [[ "$table" == pi ]]; then
    for seat in implementer strict_implementer reviewer; do
        case "$seat" in
            implementer) v="$implementer"; t="$implementer_thinking" ;;
            strict_implementer) v="$strict_implementer"; t="$strict_implementer_thinking" ;;
            reviewer) v="$reviewer"; t="$reviewer_thinking" ;;
        esac
        if [[ -z "$v" && -n "$t" ]]; then
            set_key "${seat}_thinking" ""
            warn "${seat}_thinking is set but ${seat} has no pinned model; ignored."
        fi
    done
fi

if [[ "$warn_count" -gt 3 ]]; then
    warn_lines="${warn_lines}"$'\n'"- … $((warn_count - 3)) more"
    warn_json="${warn_json},\"… $((warn_count - 3)) more\""
fi

# --- OpenCode: output --------------------------------------------------------------

if [[ "$harness" == opencode ]]; then
    # seat_line <seat> <agent file stem> <value>: the seat's line in the table.
    seat_line() {
        local v="$3" m
        if [[ -z "$v" ]]; then
            printf -- '- %s (agent fablepowers-%s, agents/%s.md): session model (unpinned)' "$1" "$2" "$2"
            return 0
        fi
        m="${v%%#*}"
        if [[ "$v" == *#* ]]; then
            printf -- '- %s (agent fablepowers-%s, agents/%s.md): model %s, variant %s' "$1" "$2" "$2" "$m" "${v#*#}"
        else
            printf -- '- %s (agent fablepowers-%s, agents/%s.md): model %s' "$1" "$2" "$2" "$m"
        fi
    }
    # seat_json <value>: {"providerID","id","variant"} split from provider/model[#variant],
    # or null when the seat is unpinned. Values were validated by the parser.
    seat_json() {
        local v="$1" m variant="null"
        if [[ -z "$v" ]]; then
            printf 'null'
            return 0
        fi
        m="${v%%#*}"
        if [[ "$v" == *#* ]]; then
            variant="\"$(escape_for_json "${v#*#}")\""
        fi
        printf '{"providerID":"%s","id":"%s","variant":%s}' \
            "$(escape_for_json "${m%%/*}")" "$(escape_for_json "${m#*/}")" "$variant"
    }

    # One warning names every unpinned seat (after the parser's warnings).
    unpinned=""
    for seat in implementer strict_implementer reviewer; do
        case "$seat" in
            implementer) v="$implementer" ;;
            strict_implementer) v="$strict_implementer" ;;
            reviewer) v="$reviewer" ;;
        esac
        if [[ -z "$v" ]]; then
            unpinned="${unpinned:+${unpinned}, }${seat}"
        fi
    done
    if [[ -n "$unpinned" ]]; then
        w="unpinned seats run on the session model: ${unpinned}; pin them in the [opencode] table of models.toml."
        warn_count=$((warn_count + 1))
        warn_lines="${warn_lines}"$'\n'"- ${w}"
        warn_json="${warn_json},\"$(escape_for_json "$w")\""
    fi

    opencode_ref="${plugin_root}/skills/workflow/references/opencode.md"
    preamble="You have fablepowers on OpenCode. The workflow map below is \`fablepowers:workflow\`, your entry point for substantive dev work. Before invoking another fablepowers skill, dispatching a seat or asking for design approval, read the OpenCode mapping in \`${opencode_ref}\`. Plugin root: \`${plugin_root}\`."
    if [[ -n "$models_file" ]]; then
        seat_source="the [opencode] table of ${models_file}"
    else
        seat_source="no models.toml since HOME and XDG_CONFIG_HOME are unset"
    fi
    preamble="${preamble}"$'\n'"Seat table (${seat_source}); dispatch each seat as its fablepowers agent and never pass a model:"
    preamble="${preamble}"$'\n'"$(seat_line implementer implementer "$implementer")"
    preamble="${preamble}"$'\n'"$(seat_line strict_implementer strict-implementer "$strict_implementer")"
    preamble="${preamble}"$'\n'"$(seat_line reviewer reviewer "$reviewer")"
    if [[ "$warn_count" -gt 0 ]]; then
        preamble="${preamble}"$'\n'"models.toml warnings (${warn_count}):${warn_lines}"
    fi

    session_context="$(escape_for_json "${preamble}")\\n\\n$(escape_for_json "${workflow_content}")"
    printf '{"context":"%s","seats":{"implementer":%s,"strict_implementer":%s,"reviewer":%s},"warnings":[%s]}\n' \
        "$session_context" "$(seat_json "$implementer")" "$(seat_json "$strict_implementer")" \
        "$(seat_json "$reviewer")" "${warn_json#,}"
    exit 0
fi

# --- Pi: output ------------------------------------------------------------------

if [[ "$harness" == pi ]]; then
    # pi_seat_line <seat> <agent file stem> <model> <thinking>: the seat's line in the table.
    pi_seat_line() {
        if [[ -z "$3" ]]; then
            printf -- '- %s (seat %s, agents/%s.md): session model and thinking (unpinned)' "$1" "$1" "$2"
        elif [[ -n "$4" ]]; then
            printf -- '- %s (seat %s, agents/%s.md): model %s, thinking %s' "$1" "$1" "$2" "$3" "$4"
        else
            printf -- "- %s (seat %s, agents/%s.md): model %s, Pi's default thinking" "$1" "$1" "$2" "$3"
        fi
    }
    # pi_seat_json <model> <thinking>: {"provider","id","thinking"} split from
    # provider/model-id, or null when the seat is unpinned. Values were validated
    # by the parser.
    pi_seat_json() {
        local m="$1" thinking="null"
        if [[ -z "$m" ]]; then
            printf 'null'
            return 0
        fi
        if [[ -n "$2" ]]; then
            thinking="\"$(escape_for_json "$2")\""
        fi
        printf '{"provider":"%s","id":"%s","thinking":%s}' \
            "$(escape_for_json "${m%%/*}")" "$(escape_for_json "${m#*/}")" "$thinking"
    }

    # One warning names every unpinned seat (after the parser's warnings).
    unpinned=""
    for seat in implementer strict_implementer reviewer; do
        case "$seat" in
            implementer) v="$implementer" ;;
            strict_implementer) v="$strict_implementer" ;;
            reviewer) v="$reviewer" ;;
        esac
        if [[ -z "$v" ]]; then
            unpinned="${unpinned:+${unpinned}, }${seat}"
        fi
    done
    if [[ -n "$unpinned" ]]; then
        w="unpinned seats run on the session model: ${unpinned}; pin them in the [pi] table of models.toml."
        warn_count=$((warn_count + 1))
        warn_lines="${warn_lines}"$'\n'"- ${w}"
        warn_json="${warn_json},\"$(escape_for_json "$w")\""
    fi

    pi_ref="${plugin_root}/skills/workflow/references/pi.md"
    preamble="You have fablepowers on Pi. The workflow map below is \`fablepowers:workflow\`, your entry point for substantive dev work. Before invoking another fablepowers skill, dispatching a seat or asking for design approval, read the Pi mapping in \`${pi_ref}\`. Plugin root: \`${plugin_root}\`."
    preamble="${preamble}"$'\n'"Skill names: a skill written \`fablepowers:<x>\` is the Pi skill \`fablepowers-<x>\`."
    if [[ -n "$models_file" ]]; then
        seat_source="the [pi] table of ${models_file}"
    else
        seat_source="no models.toml since HOME and XDG_CONFIG_HOME are unset"
    fi
    preamble="${preamble}"$'\n'"Seat table (${seat_source}); dispatch each seat with the \`fablepowers_dispatch\` tool, which applies its model and thinking:"
    preamble="${preamble}"$'\n'"$(pi_seat_line implementer implementer "$implementer" "$implementer_thinking")"
    preamble="${preamble}"$'\n'"$(pi_seat_line strict_implementer strict-implementer "$strict_implementer" "$strict_implementer_thinking")"
    preamble="${preamble}"$'\n'"$(pi_seat_line reviewer reviewer "$reviewer" "$reviewer_thinking")"
    if [[ "$warn_count" -gt 0 ]]; then
        preamble="${preamble}"$'\n'"models.toml warnings (${warn_count}):${warn_lines}"
    fi

    session_context="$(escape_for_json "${preamble}")\\n\\n$(escape_for_json "${workflow_content}")"
    printf '{"context":"%s","seats":{"implementer":%s,"strict_implementer":%s,"reviewer":%s},"warnings":[%s]}\n' \
        "$session_context" "$(pi_seat_json "$implementer" "$implementer_thinking")" \
        "$(pi_seat_json "$strict_implementer" "$strict_implementer_thinking")" \
        "$(pi_seat_json "$reviewer" "$reviewer_thinking")" "${warn_json#,}"
    exit 0
fi

# --- Codex: output ---------------------------------------------------------------

codex_ref="${plugin_root}/skills/workflow/references/codex.md"
preamble="You have fablepowers on Codex. The workflow map below is \`fablepowers:workflow\`, your entry point for substantive dev work. Before invoking another fablepowers skill, dispatching a seat or asking for design approval, read the Codex mapping in \`${codex_ref}\`. Plugin root: \`${plugin_root}\`."
if [[ -n "$models_file" ]]; then
    seat_source="defaults, overridden by the [codex] table of ${models_file}"
else
    seat_source="defaults; no models.toml since HOME and XDG_CONFIG_HOME are unset"
fi
preamble="${preamble}"$'\n'"Seat table (${seat_source}); spawn each seat with exactly this model and reasoning_effort:"
preamble="${preamble}"$'\n'"- implementer (agents/implementer.md): model ${implementer}, reasoning_effort ${implementer_effort}"
preamble="${preamble}"$'\n'"- strict_implementer (agents/strict-implementer.md): model ${strict_implementer}, reasoning_effort ${strict_implementer_effort}"
preamble="${preamble}"$'\n'"- reviewer (agents/reviewer.md): model ${reviewer}, reasoning_effort ${reviewer_effort}"
if [[ "$warn_count" -gt 0 ]]; then
    preamble="${preamble}"$'\n'"models.toml warnings (${warn_count}):${warn_lines}"
fi

session_context="$(escape_for_json "${preamble}")\\n\\n$(escape_for_json "${workflow_content}")"

# printf rather than a heredoc: bash 5.3+ can hang on heredocs in hooks.
printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"

exit 0
